{
  "name": "DesignKit 移动端",
  "short_name": "DesignKit",
  "description": "电商视觉：拍照上传、生成进度、审核与结果分享。",
  "lang": "zh-CN",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["business", "productivity", "photo"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "拍摄上传", "short_name": "拍摄", "url": "./#/capture", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "待审核", "short_name": "审核", "url": "./#/jobs", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
