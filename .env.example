# 服务
APP_ADDR=:8080
APP_ENV=dev
PUBLIC_URL=http://localhost:8080

# 数据库：本地默认 sqlite，生产用 postgres
DB_DRIVER=sqlite
DB_DSN=file:designkit.db?_pragma=busy_timeout(5000)
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=designkit password=designkit dbname=designkit port=5432 sslmode=disable TimeZone=UTC

# 自动迁移仅用于本地开发；生产用 db/migrations 下的 SQL
AUTO_MIGRATE=true

# 令牌
JWT_SECRET=dev-insecure-change-me
ACCESS_TTL=30m
REFRESH_TTL=720h

# 存储
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25

# 平台管理员（首次启动自动创建或提升）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpass12345

# 队列
RUN_WORKER=true
WORKER_TICK=2s

# AI 供应商：mock（默认，链路可跑）| openai（OpenAI 兼容接口）
PROVIDER=mock
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
COST_PER_IMAGE_CENTS=4
COST_PER_ANALYSIS_CENTS=1

# 对象存储：local | s3（AWS S3 / Cloudflare R2 / MinIO）
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=designkit
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_PREFIX=designkit
# S3_USE_PATH_STYLE=true

# 前端静态资源目录（相对进程工作目录）
WEB_DIR=../../web
MOBILE_DIR=../../mobile
