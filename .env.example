# 服务
APP_ADDR=:8080
APP_ENV=dev
PUBLIC_URL=http://localhost:8080

# 数据库：本地默认 sqlite，生产用 postgres
DB_DRIVER=sqlite
DB_DSN=file:designkit.db?_pragma=busy_timeout(5000)
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=designkit password=designkit dbname=designkit port=5432 sslmode=disable TimeZone=UTC

# 自动迁移仅用于本地开发；生产用 db/migrations 下的 SQL
AUTO_MIGRATE=true

# 令牌
JWT_SECRET=dev-insecure-change-me
ACCESS_TTL=30m
REFRESH_TTL=720h

# 存储
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25

# 平台管理员（首次启动自动创建或提升）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpass12345

# 队列
RUN_WORKER=true
WORKER_TICK=2s
